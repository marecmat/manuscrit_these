	language = {en},
	month = jul,
	number = {1},
	pages = {83--114},
	shorttitle = {Sound {Absorption} {Structures}},
	title = {Sound {Absorption} {Structures}: {From} {Porous} {Media} to {Acoustic} {Metamaterials}},
	url = {http://www.annualreviews.org/doi/10.1146/annurev-matsci-070616-124032},
