@article{leeDeepLearningacceleratedMultiple2025,
  title = {Deep Learning-Accelerated Multiple Design Generation for Sound-Absorbing Metaporous Materials},
  author = {Lee, Sooyoung and Lee, Jihun and Lee, Joong Seok and Lee, Seungchul},
  year = {2025},
