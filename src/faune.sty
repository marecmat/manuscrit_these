\ProvidesPackage{./src/faune}

\RequirePackage[no-math]{fontspec}
\newfontfamily{\Faune}[
  NFSSFamily=Faune-Text,
  Path=./src/fonts/,
  Extension = .ttf,
  Ligatures = TeX,
  UprightFont = *_Regular,
  BoldFont = *_Bold,
  ItalicFont = *_Italic,
]{Faune}

\DeclareOption{default}{%
  \renewcommand{\familydefault}{Faune}%
}
\ProcessOptions\relax
